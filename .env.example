# ============================================================================
# LuxCars Perú — variables de entorno
# ============================================================================
# Copia este archivo como `.env.local` y complétalo. En Vercel, las mismas
# variables van en Project Settings → Environment Variables.
#
# EL SITIO FUNCIONA SIN NINGUNA DE ESTAS VARIABLES. Si faltan, la capa de datos
# (src/lib/db/) devuelve listas vacías y los formularios derivan al cliente a
# WhatsApp. No hay errores de build ni páginas rotas.
# ============================================================================

# ── Neon (organización GIANFRANCO, proyecto luxcarsperu) ────────────────────

# Dirección https de la base, SIN usuario, contraseña ni parámetros:
# https://<endpoint>.<región>.aws.neon.tech/<base>. Es el host de la cadena de
# conexión (sin "-pooler") más el nombre de la base. De ella se derivan la Data
# API y Neon Auth (src/lib/db/neonConfig.ts).
# Pública: se incluye en el bundle del navegador. Solo permite lo que dejen las
# políticas RLS. Sin ella no hay lectura de inventario ni inicio de sesión.
NEXT_PUBLIC_NEON_URL=https://ep-TU-ENDPOINT.c-16.us-east-1.aws.neon.tech/neondb

# Cadena de conexión de Postgres (secreta). Entra como dueño de la base y
# SALTA TODAS LAS POLÍTICAS RLS.
# Solo servidor: jamás con prefijo NEXT_PUBLIC_, jamás en el repositorio, jamás
# en un componente "use client". Es OBLIGATORIA para guardar leads: la tabla
# `leads` no otorga INSERT al rol anónimo (si el acceso anónimo pudiera
# insertar, cualquiera podría llenar el embudo de basura desde la consola del
# navegador). Sin ella, los formularios siguen funcionando y derivan a WhatsApp.
# Neon → Connect → Connection string (la "pooled").
DATABASE_URL=

# Secreto con el que se firma la cookie de sesión del portal. Mínimo 32
# caracteres; genera uno con: openssl rand -base64 32
# Solo servidor. Sin él, el login del portal responde "sin configurar".
NEON_AUTH_COOKIE_SECRET=

# ── Fotos del stock (Neon Object Storage) ───────────────────────────────────

# Dirección S3 de la rama: https://<rama>.storage.<región>.aws.neon.tech
# Pública: es la misma que aparece en la URL de cada foto.
# Neon → Connect → pestaña Storage → AWS_ENDPOINT_URL_S3.
NEXT_PUBLIC_NEON_STORAGE_URL=

# Credencial con permiso storage:write (secreta, solo servidor). Sin ella las
# fotos se pueden ver pero no subir ni borrar.
# Neon → Connect → pestaña Storage: AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY.
# Acá llevan otro nombre porque Vercel reserva los AWS_* para su propio entorno.
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=

# Región del bucket. Normalmente no hace falta: se deduce de la dirección.
# NEON_STORAGE_REGION=us-east-1

# Bucket con las fotos del stock, público en lectura. Se crea una vez en Neon
# (ver db/migrations/20260915090300_vehicle_photos.sql).
# Solo defínela si alguna vez se renombra el bucket. Por defecto: vehiculos.
# NEXT_PUBLIC_VEHICLE_PHOTOS_BUCKET=vehiculos

# ============================================================================
# NO agregar aquí llaves de MarketCheck, Auto.dev, eBay, Autotrader, CarGurus,
# Cars.com, TrueCar, AutoTempest ni Facebook Marketplace con intención de
# guardar su inventario en la base de datos. Sus contratos prohíben
# expresamente almacenar, cachear o indexar esos datos, y el incumplimiento
# implica revocación de la llave. El inventario se carga manualmente desde el
# admin y se autocompleta por VIN contra NHTSA vPIC, que es gratuito, público y
# no requiere llave alguna. Detalle en src/lib/db/types.ts.
# ============================================================================
